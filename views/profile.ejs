<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Glassmorphism Mezun Paneli</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- CSS kodları-->
    <link rel="stylesheet" href="/css/profile.css">
    <!-- Google Fonts: 'Outfit' (Modern Geometric Sans) -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

    <div class="container">

        <!-- Floating Navbar -->
        <nav class="glass-card glass-navbar">
            <a href="/" class="brand-logo">Mezun<span style="font-weight:300">Soft</span></a>
            <div class="nav-links">
                <a href="#" class="active">Yıllık İşlemleri</a>
            </div>
            <div class="d-none d-md-block">
                <div class="d-flex gap-3">
                    <div class="position-relative d-inline-block me-3" id="btnNotifications" style="cursor:pointer">
                        <i class="fas fa-bell fs-5 text-dark opacity-75"></i>
                        <span id="notificationBadge"
                            class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                            style="font-size: 0.6rem; display: none;">
                            0
                        </span>
                    </div>
                </div>
            </div>
        </nav>

        <div class="row">

            <!-- LEFT COLUMN -->
            <div class="col-lg-3">
                <div class="glass-card">
                    <div class="profile-section">
                        <div class="avatar-glass">
                            <i class="fas fa-user"></i>
                        </div>
                        <h5 class="fw-bold mb-1" id="username">Öğrenci İsmi</h5>
                        <small class="text-muted fw-bold" id="rolePanel">ÖĞRENCİ PANELİ</small>
                    </div>

                    <ul class="menu-list">
                        <li><a href="#" class="menu-item nav-trigger" data-target="panel-profile"><i
                                    class="fas fa-user-circle me-2"></i> Profilim</a></li>

                        <hr style="opacity:0.1">
                        <small class="ps-3 text-muted fw-bold" style="font-size:0.7rem; letter-spacing:1px;">YILLIK
                            YÖNETİMİ</small>

                        <li><a href="#" class="menu-item nav-trigger active" data-target="panel-yearbook"><i
                                    class="fas fa-info-circle me-2"></i> Yıllık Bilgileri</a></li>
                        <li><a href="#" class="menu-item nav-trigger" data-target="panel-announcements"><i
                                    class="fas fa-bullhorn me-2"></i> Duyurular</a></li>
                        <li><a href="#" class="menu-item nav-trigger" data-target="panel-write"><i
                                    class="fas fa-pen-alt me-2"></i> Arkadaşına Yaz</a></li>
                        <li><a href="#" class="menu-item nav-trigger" data-target="panel-memories"><i
                                    class="fas fa-book-open me-2"></i> Anılarım</a></li>
                        <li><a href="#" class="menu-item nav-trigger" data-target="panel-photos"><i
                                    class="fas fa-camera-retro me-2"></i> Fotoğraflar</a></li>
                    </ul>
                </div>
            </div>

            <!-- MIDDLE COLUMN -->
            <div class="col-lg-6" id="middle-content-area">
                <div class="glass-card h-100 p-4">

                    <div id="panel-yearbook" class="content-section fade-in">
                        <div class="content-header p-0 mb-3 border-0">
                            <div>
                                <h4 class="mb-0 fw-bold">Genel Bilgiler</h4>
                                <p class="mb-0 text-muted small">Okul ve yıllık süreç detayları</p>
                            </div>
                            <span class="glass-badge" id="gradeInfo"></span>
                        </div>

                        <div class="glass-table">
                            <div class="glass-row">
                                <div class="lbl">Okul Adı</div>
                                <div class="val" id="schoolName">Yükleniyor...</div>
                            </div>
                            <div class="glass-row">
                                <div class="lbl">Yıllık Sorumlusu</div>

                                <div class="val d-flex align-items-center">
                                    <span class="bg-white rounded-circle p-1 me-2 shadow-sm"><i
                                            class="text-primary small"></i></span>
                                    Öğretmen
                                </div>
                            </div>
                            <div class="glass-row">
                                <div class="lbl">E-Posta</div>
                                <div class="val text-primary text-decoration">1@gmail.com</div>
                            </div>
                            <div class="glass-row">
                                <div class="lbl">Kapak Tasarımı</div>
                                <div class="val"><i class="val"></i>Belirlenecek
                                </div>
                            </div>
                            <div class="glass-row">
                                <div class="lbl">Kağıt Tercihi</div>
                                <div class="val">Kuşe Kağıt (1. Hamur)</div>
                            </div>
                            <div class="glass-row">
                                <div class="lbl">Kağıt Ebatları</div>
                                <div class="val text-success" id="pageSize"></div>
                            </div>
                            <div class="glass-row">
                                <div class="lbl">Mevcut Durum</div>
                                <div class="val text-success" id="status">Komite İncelemesi</div>
                            </div>
                        </div>
                    </div>

                    <div id="panel-profile" class="content-section d-none fade-in">
                        <h4 class="fw-bold mb-4">Profil Bilgileri</h4>
                        <form id="profileUpdateForm">

                            <div class="mb-3">
                                <label class="small fw-bold text-muted">Ad Soyad</label>
                                <input type="text" class="form-control" id="inputFullname" disabled>
                            </div>
                            <div class="mb-3">
                                <label class="small fw-bold text-muted">E-Posta</label>
                                <input type="email" class="form-control" id="inputEmail" disabled>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="small fw-bold text-muted">Öğrenci Numarası</label>
                                    <input type="text" class="form-control" id="inputStudentNumber" disabled>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="small fw-bold text-muted">Şube / Sınıf</label>
                                    <input type="text" class="form-control" id="inputClassInfo" disabled>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div id="panel-announcements" class="content-section d-none fade-in">
                        <h4 class="fw-bold mb-3">Duyurular</h4>
                        <div id="announcementListContainer">
                            <!-- Duyurular buraya JS ile gelecek -->
                        </div>
                        <!-- Pagination Container for Announcements -->
                        <div id="announcement-pagination-controls" class="pagination-container mt-4 d-flex justify-content-center gap-2"></div>
                    </div>

                    <div id="panel-write" class="content-section d-none fade-in">
                        <h4 class="fw-bold mb-3">Arkadaşına Yaz</h4>
                        <div class="input-group mb-4">
                            <span class="input-group-text bg-white border-end-0"><i
                                    class="fas fa-search text-muted"></i></span>
                            <input type="text" id="searchFriend" class="form-control border-start-0 ps-0"
                                placeholder="Öğrenci ara...">
                        </div>

                        <div id="classmatesList" class="d-flex flex-column gap-3">
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-spinner fa-spin fa-2x"></i>
                                <p class="mt-2">Liste yükleniyor...</p>
                            </div>
                        </div>
                        
                        <!-- Pagination Container -->
                        <div id="pagination-controls" class="pagination-container mt-4 d-flex justify-content-center gap-2"></div>
                    </div>

                    <div id="panel-memories" class="content-section d-none fade-in">
                        <h4 class="fw-bold mb-4">Anı Defteri</h4>

                        <div class="d-flex justify-content-center gap-3 mb-3">
                            <button class="btn btn-primary rounded-pill px-4 active-tab-btn" id="btnShowReceived">
                                <i class="fas fa-inbox me-2"></i>Bana Yazılanlar
                            </button>
                            <button class="btn btn-outline-primary rounded-pill px-4" id="btnShowSent">
                                <i class="fas fa-paper-plane me-2"></i>Benim Yazdıklarım
                            </button>
                        </div>

                        <!-- KARAKTER SAYACI -->
                        <div id="memoryCharacterCount" class="text-center mb-4 fw-bold small d-none">
                            Toplam Karakter: <span id="charCountVal">0</span> / 13000
                        </div>

                        <div id="myMemoriesList" class="d-flex flex-column gap-4">
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-spinner fa-spin"></i> Yükleniyor...
                            </div>
                        </div>
                    </div>

                    <div id="panel-photos" class="content-section d-none fade-in">
                        <h4 class="fw-bold mb-3">Fotoğraf Yönetimi</h4>
                        
                        <!-- TAB MENÜSÜ -->
                        <ul class="nav nav-pills mb-4 gap-2 justify-content-center" id="pills-tab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active rounded-pill px-3 py-2 small fw-bold photo-tab-btn" data-category="personal" type="button" style="font-size: 0.85rem;">
                                    <i class="fas fa-user me-1"></i>Kişisel (Max 4)
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link rounded-pill px-3 py-2 small fw-bold photo-tab-btn" data-category="class" type="button" style="font-size: 0.85rem;">
                                    <i class="fas fa-users me-1"></i>Sınıf (Max 20)
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link rounded-pill px-3 py-2 small fw-bold photo-tab-btn" data-category="extra" type="button" style="font-size: 0.85rem;">
                                    <i class="fas fa-star me-1"></i>Ekstra
                                </button>
                            </li>
                        </ul>

                        <!-- YÜKLEME ALANI -->
                        <div class="glass-card p-4 mb-4 text-center border-dashed upload-area" id="photoUploadArea">
                            <i class="fas fa-cloud-upload-alt fa-3x text-primary mb-3"></i>
                            <h6 class="fw-bold">Fotoğraf Yükle</h6>
                            <p class="text-muted small mb-3">Sadece JPG, PNG formatları. Max 5MB.</p>
                            
                            <input type="file" id="photoInput" class="d-none" accept="image/*">
                            <button class="btn btn-outline-primary rounded-pill px-4" onclick="document.getElementById('photoInput').click()">
                                Dosya Seç
                            </button>
                            <div id="uploadStatus" class="mt-2 small fw-bold"></div>
                        </div>

                        <!-- FOTOĞRAF GALERİSİ -->
                        <div id="photoGallery" class="row g-3">
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-spinner fa-spin"></i> Fotoğraflar yükleniyor...
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- RIGHT COLUMN -->
            <div class="col-lg-3" id="right-sidebar-summary">
                <div class="glass-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h6 class="fw-bold mb-0">Yıllık Özeti</h6>
                        <i class="fas fa-chart-pie text-muted"></i>
                    </div>

                    <div class="stat-card">
                        <div>
                            <div class="stat-num" id="statStudentCount">-</div>
                            <div class="stat-desc">Öğrenci</div>
                        </div>
                        <i class="fas fa-user-graduate text-muted opacity-25 fa-2x"></i>
                    </div>

                    <div class="stat-card">
                        <div>
                            <div class="stat-num" id="statTeacherCount">-</div>
                            <div class="stat-desc">Komite</div>
                        </div>
                        <i class="fas fa-users-cog text-muted opacity-25 fa-2x"></i>
                    </div>

                    <div class="mt-4">
                        <div class="d-flex justify-content-between small fw-bold mb-1">
                            <span>Tamamlanma</span>
                            <span id="progressText">0%</span>
                        </div>
                        <div class="progress-glass">
                            <div id="yearbookProgressBar" class="progress-bar-glass" style="width: 0%"></div>
                        </div>
                        <p class="text-center mt-3 small text-muted" id="statusDescription">
                            <i class="fas fa-spinner fa-spin me-1"></i>
                            Durum yükleniyor...
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- modal paneli için gerekli html -->
    <div class="modal fade" id="writeMemoryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card border-0">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Anı Yazısı</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        <strong id="modalTargetName" class="text-dark">...</strong> adlı arkadaşının yıllığına
                        yazıyorsun.
                    </p>
                    <form id="memoryForm">
                        <input type="hidden" name="to_student_id" id="modalTargetId">
                        <div class="mb-3">
                            <textarea name="content" class="form-control" rows="5"
                                placeholder="İçinden geçenleri yaz..." required style="resize: none;"></textarea>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="fas fa-paper-plane me-2"></i>Gönder
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Model Paneli için gerekli HTML kodu -->
    <div class="modal fade" id="notificationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content glass-card border-0">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="fas fa-bell text-warning me-2"></i>Bildirimler</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div id="notificationList" class="list-group list-group-flush gap-2">
                        <div class="text-center p-4">
                            <i class="fas fa-spinner fa-spin text-muted"></i>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-secondary rounded-pill"
                        data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <!-- memory düzenleme için gerekli iskelet -->
    <div class="modal fade" id="editMemoryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card border-0">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold"><i class="fas fa-edit text-primary me-2"></i>Anıyı Düzenle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        <strong id="editModalTargetName" class="text-dark">...</strong> için yazdığın anıyı
                        düzenliyorsun.
                        <br>
                        <span class="text-warning"><i class="fas fa-info-circle"></i> Düzenleme sonrası yazı tekrar
                            onaya düşecektir.</span>
                    </p>
                    <form id="editMemoryForm">
                        <input type="hidden" id="editMemoryId">

                        <div class="mb-3">
                            <textarea id="editMemoryContent" class="form-control" rows="5" required
                                style="resize: none;"></textarea>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="fas fa-save me-2"></i>Güncelle ve Gönder
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Lightbox Modal (Fotoğraf Önizleme) -->
    <div id="lightboxModal" class="lightbox-overlay d-none">
        <span class="lightbox-close">&times;</span>
        <img class="lightbox-content" id="lightboxImage">
        <div id="lightboxCaption"></div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/auth-check.js"></script> <!-- Token Yenileme Sistemi -->
    <script src="/js/Profile.js"></script>
    <script src="/js/memories.js"></script>
</body>

</html>