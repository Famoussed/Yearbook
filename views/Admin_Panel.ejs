<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Glass Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/Admin_Panel.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

    <div class="wrapper">
        <nav id="sidebar" class="glass-panel">
            <div class="sidebar-header">
                <a href="/" style="text-decoration: none;">
                    <div class="admin-logo">Mezun<span style="font-weight:300">Soft</span></div>
                </a>
            </div>

            <ul class="sidebar-menu">
                <li><a href="#" class="nav-trigger active" data-target="panel-dashboard"><i class="fas fa-th-large"></i>
                        Dashboard</a></li>
                <li><a href="#" class="nav-trigger" data-target="panel-users"><i class="fas fa-users"></i>
                        Kullanıcılar</a></li>
                <li><a href="#" class="nav-trigger" data-target="panel-approvals"><i class="fas fa-book"></i> Yıllık
                        Onayları</a></li>
                <li><a href="#" class="nav-trigger" data-target="panel-create"><i class="fas fa-hammer"></i> Yıllık
                        Oluştur</a></li>
                <li><a href="#" class="nav-trigger" data-target="panel-createSchool"><i class="fas fa-school"></i> Okul/Kurum
                        Ekle</a></li>
            </ul>

            <div class="sidebar-footer">
                <p class="mb-0">MezunSoft v2.0</p>
                <small>Güvenli Bağlantı</small>
            </div>
        </nav>

        <div id="content">

            <div class="glass-panel top-glass-bar">
                <h4 class="mb-0 fw-bold d-none d-md-block text-dark">Yönetim Paneli</h4>

                <div class="d-flex align-items-center gap-3">
                    <input type="text" class="search-glass" placeholder="Arama yap...">

                    <button class="btn btn-light rounded-circle shadow-sm" style="width:40px; height:40px;">
                        <i class="fas fa-bell text-muted"></i>
                    </button>

                    <div
                        class="d-flex align-items-center gap-2 bg-white bg-opacity-75 px-3 py-1 rounded-pill cursor-pointer shadow-sm">
                        <span class="fw-bold small text-dark">Süper Admin</span>
                    </div>
                </div>
            </div>

            <div id="panel-dashboard" class="content-section fade-in">
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="glass-panel stat-card">
                            <div class="stat-value text-primary">7</div>
                            <div class="stat-label">Toplam Öğrenci</div>
                            <i class="fas fa-user-graduate stat-icon-bg text-primary"></i>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-panel stat-card">
                            <div class="stat-value text-warning">0</div>
                            <div class="stat-label">Onay Bekleyen</div>
                            <i class="fas fa-clock stat-icon-bg text-warning"></i>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-panel stat-card">
                            <div class="stat-value text-danger">1</div>
                            <div class="stat-label">Toplam Danışman</div>
                            <i class="fas fa-headset stat-icon-bg text-danger"></i>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-12">
                        <div class="glass-panel p-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="fw-bold mb-0 text-dark">Son İşlemler</h5>
                                <button class="btn btn-sm btn-dark rounded-pill px-3">Tümünü Gör</button>
                            </div>

                            <div class="table-responsive">
                                <table class="glass-table">
                                    <thead>
                                        <tr>
                                            <th>Okul Adı</th>
                                            <th>Sorumlu</th>
                                            <th>Tarih</th>
                                            <th>Durum</th>
                                            <th>Yıllık Adı</th>
                                        </tr>
                                    </thead>
                                    <tbody id="yearbooksTableBody">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">Veriler yükleniyor...
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="panel-users" class="content-section d-none fade-in">
                <div class="glass-panel p-5 text-center">
                    <i class="fas fa-users fa-3x text-muted mb-3 opacity-50"></i>
                    <h3>Kullanıcı Yönetimi</h3>
                    <p class="text-muted">Bu alan henüz yapım aşamasındadır.</p>
                </div>
            </div>

            <div id="panel-approvals" class="content-section d-none fade-in">
                <div class="glass-panel p-5 text-center">
                    <i class="fas fa-check-double fa-3x text-muted mb-3 opacity-50"></i>
                    <h3>Onay Bekleyen İşlemler</h3>
                    <p class="text-muted">Bu alan henüz yapım aşamasındadır.</p>
                </div>
            </div>

            <div id="panel-create" class="content-section d-none fade-in">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="glass-panel p-4">
                            <h4 class="fw-bold mb-4 text-dark"><i class="fas fa-hammer me-2"></i>Yeni Yıllık Oluştur
                            </h4>

                            <form id="createYearbookForm">
                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="glass-form-label">Yıllık Adı</label>
                                        <input type="text" name="YearBookName" class="glass-form-control"
                                            placeholder="Örn: 2025 Fen Lisesi Yıllığı" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="glass-form-label">Eğitim Yılı</label>
                                        <input type="text" name="EduDate" class="glass-form-control" value="2025-2026"
                                            required>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="glass-form-label">Okul ID (School ID)</label>
                                        <input type="number" name="school_id" class="glass-form-control"
                                            placeholder="Örn: 1" required>
                                        <small class="text-muted d-block mb-3"
                                            style="margin-top:-10px; font-size:0.75rem;">Okullar listesinden ID'yi
                                            kontrol edin.</small>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="glass-form-label">Sorumlu Kişi</label>
                                        <select name="ResponsedPerson" class="glass-form-control">
                                            <option value="Öğretmen">Öğretmen</option>
                                            <option value="Öğrenci Temsilcisi">Öğrenci Temsilcisi</option>
                                            <option value="Okul İdaresi">Bayii</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="glass-form-label">Kağıt Türü</label>
                                        <select name="PaperType" class="glass-form-control">
                                            <option value="Kuşe Kağıt">Kuşe Kağıt</option>
                                            <option value="Kitap Kağıdı">Kitap Kağıdı</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="glass-form-label">Sayfa Ebatları</label>
                                        <select name="PageSizes" class="glass-form-control">
                                            <option value="Kare Yıllık">Kare Yıllık (20x20)</option>
                                            <option value="A4 Dikey">A4 Dikey</option>
                                            <option value="A4 Yatay">A4 Yatay</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="glass-form-label">Durum</label>
                                        <select name="YearBookStatus" class="glass-form-control">
                                            <option value="Hazırlık Aşamasında">Hazırlık Aşamasında</option>
                                            <option value="Yayında">Yayında</option>
                                        </select>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-dark w-100 py-3 rounded-pill fw-bold mt-2">
                                    Yıllığı Oluştur <i class="fas fa-arrow-right ms-2"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div id="panel-createSchool" class="content-section d-none fade-in">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="glass-panel p-4">
                            <h4 class="fw-bold mb-4 text-dark"><i class="fas fa-school me-2"></i>Yeni Okul Ekle</h4>
                            
                            <form id="createSchoolForm">
                                <div class="mb-3">
                                    <label class="glass-form-label">Okul Adı</label>
                                    <input type="text" name="name" class="glass-form-control" placeholder="Örn: Ankara Fen Lisesi" required>
                                </div>

                                <div class="mb-3">
                                    <label class="glass-form-label">Şehir</label>
                                    <select name="city" class="glass-form-control">
                                        <option value="Ankara">Ankara</option>
                                        <option value="İstanbul">İstanbul</option>
                                        <option value="İzmir">İzmir</option>
                                        <option value="Bursa">Bursa</option>
                                        <option value="Antalya">Antalya</option>
                                        <option value="Diğer">Diğer</option>
                                    </select>
                                </div>

                                <button type="submit" class="btn btn-dark w-100 py-3 rounded-pill fw-bold mt-2">
                                    Okulu Kaydet <i class="fas fa-save ms-2"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/Admin.js"></script>
</body>

</html>