<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kayıt Ol - MezunSoft</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="/js/register.js"></script>

    <style>
        /* Senin Router dosyanla aynı CSS değişkenleri */
        :root {
            --glass-bg: rgba(255, 255, 255, 0.40);
            --glass-border: rgba(255, 255, 255, 0.6);
            --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.10);
            --text-dark: #1e272e; 
            --accent-color: #1e272e; /* Butonlar için koyu renk */
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #cdc962 0%, #e0dc76 100%); /* Senin arkaplanın */
            min-height: 100vh;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            box-shadow: var(--glass-shadow);
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 600px; /* Form için biraz daha dar */
        }

        .form-control, .form-select {
            background: rgba(255, 255, 255, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 15px;
        }
        
        .form-control:focus {
            background: rgba(255, 255, 255, 0.8);
            box-shadow: 0 0 0 0.25rem rgba(205, 201, 98, 0.25);
            border-color: #cdc962;
        }

        .btn-custom {
            background-color: var(--accent-color);
            color: #cdc962; /* Yazı rengi sarı */
            border-radius: 10px;
            padding: 12px;
            font-weight: 600;
            width: 100%;
            transition: all 0.3s;
        }

        .btn-custom:hover {
            transform: translateY(-2px);
            background-color: #000;
            color: #fff;
        }

        .hidden { display: none !important; }
    </style>
</head>
<body>

    <div class="glass-panel">
        <div class="text-center mb-4">
            <div id="headerIcon" style="font-size: 3rem; color: var(--text-dark); margin-bottom: 10px;">
                <i class="fas fa-user-plus"></i>
            </div>
            <h2 class="fw-bold" id="pageTitle">Kayıt Ol</h2>
            <p id="pageDesc" style="opacity: 0.8;">Lütfen bilgilerinizi eksiksiz doldurun.</p>
        </div>

        <form id="registerForm">
            <input type="hidden" name="role" id="roleInput">

            <div class="mb-3">
                <input type="text" name="fullname" class="form-control" placeholder="Ad Soyad" required>
            </div>
            
            <div class="mb-3">
                <input type="text" name="tckn" class="form-control" placeholder="TC Kimlik No" maxlength="11" required>
            </div>

            <div class="mb-3">
                <input type="email" name="email" class="form-control" placeholder="E-Posta Adresi" required>
            </div>

            <div class="mb-3">
                <input type="password" name="password" class="form-control" placeholder="Şifre" required>
            </div>

            <div class="mb-3">
                <select name="school_id" id="schoolSelect" class="form-select" required>
                    <option value="" selected disabled>Okullar Yükleniyor...</option>
                </select>
            </div>

            <div id="studentFields" class="hidden">
                <hr class="my-4" style="opacity: 0.3;">
                <h5 class="mb-3 fw-bold">Öğrenci Bilgileri</h5>
                <div class="row">
                    <div class="col-6">
                        <input type="text" name="student_number" class="form-control" placeholder="Öğrenci No">
                    </div>
                    <div class="col-6">
                        <input type="text" id="classInput" class="form-control" name="class_info" placeholder="Şube (Örn: A, B, C vb.)">
                    </div>
                </div>
                <div class="mb-3">
                    <select id="grade_level_id" name="grade_level_id" class="form-select">
                        <option value="1">İlkokul</option>
                        <option value="2">Ortaokul</option>
                        <option value="3">Lise</option>
                        <option value="4">Üniversite</option>
                        <option value="5">Diğer</option>
                    </select>
                </div>
            </div>

            <div id="teacherInfo" class="hidden text-center p-3 mb-3" style="background: rgba(255,255,255,0.3); border-radius: 10px;">
                <i class="fas fa-info-circle me-2"></i>
                <small>Öğretmen kaydınız okul yönetimi tarafından onaylandıktan sonra aktif olacaktır.</small>
            </div>

            <button type="submit" class="btn btn-custom mt-3">Kaydı Tamamla</button>
        </form>

        <div class="text-center mt-4">
            <a href="/register_router" class="text-dark text-decoration-none fw-500">
                <i class="fas fa-arrow-left me-1"></i> Tür Seçimine Dön
            </a>
            <br>
            <span class="mt-2 d-inline-block" style="font-size: 0.9rem;">
                Zaten hesabın var mı? <a href="/login" class="fw-bold text-dark">Giriş Yap</a>
            </span>
        </div>
    </div>
</body>
</html>